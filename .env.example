# Copy to .env.development.local (ignored by git) if you need to override
# anything. That name rather than .env.local because the values below are
# development-only and .env.local is read in production too.
# Authentication (Discord app, allowed server, app URL) is configured in the
# app itself: open /setup on first run, later Settings > Workspace.

# PostgreSQL connection. Leave unset to use the embedded development database.
# DATABASE_URL=postgresql://user:password@host:5432/tasks
# Pending migrations are applied when the app starts (serialised with an advisory
# lock). Set to false to apply them from the deploy pipeline with `bun run db:migrate`.
# DATABASE_MIGRATE_ON_START=true

# Extra hosts allowed to load the dev server (comma separated), see next.config.ts.
# ALLOWED_DEV_ORIGINS=my-host.example

# Reverse-proxy addresses or CIDR ranges, comma separated. Sign-in rate limits
# are keyed on the client address, which behind a proxy only `x-forwarded-for`
# knows; these say which hops in it are the deployment's own. The default
# covers Docker's default address pool, so only a proxy outside it needs this.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Development only: which Discord application and server the seeded workspace
# points at. Unset just means it starts unconfigured and /setup fills it in.
# SEED_APP_URL=http://192.0.2.10:3000
# SEED_DISCORD_CLIENT_ID=
# SEED_DISCORD_GUILD_ID=

# Development only: values copied into the embedded database when it is seeded
# (or when the stored value is still empty). With a bot token, seeding mirrors the
# real Discord server instead of inventing a sample team. Never needed in
# production, where all of this is entered at /setup and lives in the database.
# SEED_DISCORD_CLIENT_SECRET=
# SEED_DISCORD_BOT_TOKEN=
# SEED_DISCORD_WEBHOOK_URL=
# Discord roles whose holders are admins, on top of the server's owner and its
# Administrator roles. Comma separated. Settings > Members > Admins after that.
# SEED_DISCORD_ADMIN_ROLE_IDS=
