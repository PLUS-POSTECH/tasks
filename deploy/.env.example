# Copy to deploy/.env (git-ignored) and fill in. Docker Compose reads it
# automatically because it sits next to compose.yml.

POSTGRES_PASSWORD=change-me

# Which build of the app to run, as an image tag. `up -d --build` tags what it
# builds with this, so giving each deploy its own tag (a date, a commit) leaves
# the previous image on the host to go back to: set the tag to it and `up -d`.
# TASKS_IMAGE_TAG=latest

# Optional overrides
# POSTGRES_DB=tasks
# POSTGRES_USER=tasks
# Set to false to run migrations from the pipeline instead of at start-up.
# DATABASE_MIGRATE_ON_START=true
# Reverse-proxy addresses or CIDR ranges, comma separated. Only needed when the
# proxy is not on a Docker network out of the default 172.16.0.0/12 pool.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12
